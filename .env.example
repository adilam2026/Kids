# --- Obligatoire ---
# Sur Railway : référence vers le service PostgreSQL (URL du réseau PRIVÉ, *.railway.internal)
DATABASE_URL=postgres://postgres@localhost:5432/petits_heros

# --- Recommandé en production ---
NODE_ENV=production
# URL publique de l'application (utilisée dans les e-mails de réinitialisation)
APP_URL=https://petits-heros.up.railway.app
# Fuseau pour « aujourd'hui » et le bilan hebdomadaire (lundi→dimanche)
APP_TZ=Europe/Paris

# --- E-mails de récupération de mot de passe : API HTTPS de Brevo (pas de SMTP) ---
# BREVO_API_KEY est SECRÈTE : uniquement dans les variables du service Railway, jamais dans le dépôt ni les journaux.
# Sans ces variables : codes de secours et codes remis par le propriétaire (aucun e-mail envoyé).
BREVO_API_KEY=
BREVO_FROM_EMAIL=expediteur-valide-chez-brevo@example.fr
BREVO_FROM_NAME="Petits Héros"
# (facultatif) MAIL_TIMEOUT_MS=10000   délai maximal de l'appel Brevo

# --- Facultatif ---
# PGSSL=true   # uniquement si la base impose TLS (pas nécessaire sur le réseau privé Railway)
# PORT est fourni par Railway
